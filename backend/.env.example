ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SAM.gov API key (free) — https://sam.gov/profile/details
# Required for SAM.gov opportunity search
SAM_GOV_API_KEY=your_sam_gov_api_key_here

# ── Database ──────────────────────────────────────────────────────────────────
# Development default (SQLite, zero-config, dev only):
DATABASE_URL=sqlite:///./simpleseed.db

# Production (PostgreSQL) — start the DB with: docker-compose up -d db
# then set:
# DATABASE_URL=postgresql+psycopg2://simpleseed:simpleseed@localhost:5432/simpleseed

# APP_ENV is informational only; the engine dialect is derived from DATABASE_URL.
APP_ENV=development

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED: Change this to a long random string before deploying.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_secure_random_string_before_deploying

# JWT signing algorithm — HS256 is fine for MVP; RS256 for key rotation later.
JWT_ALGORITHM=HS256

# ── Vector search / Embeddings (1.2) ──────────────────────────────────────────
# REQUIRED for semantic retrieval.  Without this, the system falls back to
# keyword search automatically — no other changes needed.
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Embedding model — text-embedding-3-small is the recommended default.
# 1536 dimensions, $0.02 / 1M tokens.
EMBEDDING_MODEL=text-embedding-3-small

# Number of chunks sent in one OpenAI API call.  Reduce if you hit rate limits.
EMBEDDING_BATCH_SIZE=100

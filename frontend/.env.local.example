NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Authentication ────────────────────────────────────────────────────────────
# NEXTAUTH_URL must exactly match the URL the browser hits.
NEXTAUTH_URL=http://localhost:3000

# NEXTAUTH_SECRET is used to sign the session cookie.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_generate_a_secure_random_string_before_deploying

# Server-side backend URL used by NextAuth's authorize() function.
# Does NOT need to be the same as NEXT_PUBLIC_API_URL.
BACKEND_URL=http://localhost:8000
